{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "AstroClaw",
  "description": "AWS-native AI agent platform with one-click CDK deployment, persistent chat sessions, and real-time streaming.",
  "colors": {
    "primary": "#d55816",
    "light": "#d55816",
    "dark": "#d55816"
  },
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "heading": { "family": "Inter", "weight": 600 },
    "body": { "family": "Inter", "weight": 400 }
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section",
    "latex": true
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "directory": "card",
    "tabs": [
      {
        "tab": "Get Started",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "get-started/overview"
            ]
          }
        ]
      },
      {
        "tab": "User Guide",
        "groups": [
          {
            "group": "User Guide",
            "icon": "book-open",
            "pages": [
              "user-guide/overview"
            ]
          }
        ]
      },
      {
        "tab": "Developer Guide",
        "groups": [
          {
            "group": "Developer Guide",
            "icon": "code",
            "pages": [
              "developer-guide/overview"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "github",
      "href": "https://github.com/0xjeffro/astroclaw"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/0xjeffro/astroclaw",
      "x": "https://x.com/JeffroBTC",
      "linkedin": "https://www.linkedin.com/in/0xjeffro/"
    }
  }
}
